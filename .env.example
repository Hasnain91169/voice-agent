# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every setting here has a working default; the local profile runs with this
# file left entirely blank and needs no API keys.

# ---------------------------------------------------------------------------
# Profile: local_zero_cost | low_latency
#   local_zero_cost - faster-whisper + Piper + Ollama. No API keys, no cost.
#   low_latency     - streaming cloud providers, held to the 800ms p50 bar.
# Selecting a profile sets provider defaults; anything below still overrides.
# ---------------------------------------------------------------------------
VA_PROFILE=local_zero_cost

# --- Provider selection (override the profile defaults) --------------------
# VA_ASR_PROVIDER=faster_whisper
# VA_TTS_PROVIDER=piper
# VA_LLM_PROVIDER=ollama

# --- Local providers -------------------------------------------------------
VA_OLLAMA_URL=http://127.0.0.1:11434
VA_OLLAMA_MODEL=qwen2.5:7b
VA_WHISPER_MODEL=small.en
# cuda | cpu | auto. This decides whether the local stack meets the latency
# target: ~90ms transcribe on GPU against ~1500ms on CPU. See README benchmarks.
VA_WHISPER_DEVICE=auto
# Populated by: python scripts/fetch_models.py
VA_PIPER_BIN=
VA_PIPER_VOICE=

# --- Cloud providers (only needed for the low_latency profile) -------------
VA_OPENAI_API_KEY=
VA_ANTHROPIC_API_KEY=
VA_DEEPGRAM_API_KEY=
VA_ELEVENLABS_API_KEY=

# --- Server ----------------------------------------------------------------
VA_HOST=127.0.0.1
VA_PORT=8000
# Signs the short-TTL WebSocket handshake token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VA_SESSION_SECRET=

# --- Vonage telephony (optional; browser demo needs none of this) ----------
VA_VONAGE_APPLICATION_ID=
# Path to the private key file — never paste the key itself into env
VA_VONAGE_PRIVATE_KEY_PATH=
VA_PUBLIC_BASE_URL=

# --- Turn-taking and latency knobs -----------------------------------------
# Silence that ends an utterance. Directly trades first-audio latency against
# clipping people who pause mid-sentence. See the latency budget in README.
VA_STOP_HANG_MS=250
VA_MAX_UTTERANCE_S=15.0
VA_PREBUFFER_MS=70

# --- Sensitivity -----------------------------------------------------------
# Thresholds scale to the noise floor measured at the start of each call, but a
# browser with noise suppression reports a floor near zero, so in practice these
# absolute minimums are what separate speech from silence. On the 0..32767 RMS
# scale: quiet room tone is under ~50, ordinary speech is high hundreds to low
# thousands. The server logs the effective values on every call:
#   calibrated floor=3 start=280 stop=160 barge=750
# Raise these if the agent triggers on background noise; lower them if it is
# not hearing you. Each call also logs the measured rms of what it heard.
VA_VAD_MIN_START=280
VA_VAD_MIN_STOP=160

# --- Echo control and barge-in ---------------------------------------------
VA_BARGE_IN=true
# Energy needed to interrupt the agent. The single most useful knob if it keeps
# interrupting itself on laptop speakers — raise it until it stops.
VA_BARGE_IN_MIN_RMS=750
# Guard window after the agent stops speaking, before caller audio is trusted.
VA_POST_TTS_GUARD_MS=250
# The same guard when the far end cancels echo (the browser). Smaller, because
# AEC does most of the work — but not zero, because it leaks on speakers.
VA_ECHO_CANCELLED_GUARD_MS=120
# Consecutive 20ms frames above threshold needed to accept caller speech.
VA_ONSET_FRAMES=6
# Higher bar to interrupt the agent mid-speech than to start a normal turn.
VA_BARGE_IN_FRAMES=10
# Minimum spoken audio before a candidate is transcribed and assessed.
VA_BARGE_IN_MIN_MS=500
